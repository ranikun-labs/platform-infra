{
  "carelogTaskFragment": {
    "volumes": [
      {
        "name": "carelog-tls"
      }
    ],
    "containerDefinitions": [
      {
        "name": "carelog-tls-proxy",
        "image": "REPLACE_WITH_PRIVATE_ECR_IMAGE_DIGEST",
        "essential": true,
        "portMappings": [
          {
            "protocol": "tcp",
            "containerPort": 8080
          },
          {
            "protocol": "tcp",
            "containerPort": 8443
          }
        ],
        "mountPoints": [
          {
            "sourceVolume": "carelog-tls",
            "containerPath": "/run/carelog-tls",
            "readOnly": false
          }
        ],
        "secrets": [
          {
            "name": "TLS_BUNDLE_JSON",
            "valueFrom": "REPLACE_WITH_SERVER_BUNDLE_SECRET_ARN"
          }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/ranikun-carelog-dev-api",
            "awslogs-region": "ap-northeast-2",
            "awslogs-stream-prefix": "tls-proxy"
          }
        },
        "healthCheck": {
          "command": ["CMD-SHELL", "kill -0 $(cat /run/nginx.pid) || exit 1"],
          "interval": 30,
          "timeout": 3,
          "retries": 3,
          "startPeriod": 10
        }
      }
    ],
    "appContainerAddition": {
      "portMappings": [],
      "environment": [
        {
          "value": "127.0.0.1",
          "name": "SERVER_ADDRESS"
        },
        {
          "value": "true",
          "name": "CARELOG_IDENTITY_ENROLLMENT_ENABLED"
        },
        {
          "value": "false",
          "name": "SPRING_FLYWAY_ENABLED"
        }
      ]
    }
  },
  "coreTaskFragment": {
    "volumes": [
      {
        "name": "carelog-trust"
      }
    ],
    "initContainer": {
      "name": "carelog-trust-init",
      "image": "REPLACE_WITH_TRUST_INIT_IMAGE_BUILT_FROM_CORE_DIGEST",
      "essential": false,
      "mountPoints": [
        {
          "sourceVolume": "carelog-trust",
          "containerPath": "/run/carelog-trust",
          "readOnly": false
        }
      ]
    },
    "coreContainerAddition": {
      "dependsOn": [
        {
          "containerName": "carelog-trust-init",
          "condition": "SUCCESS"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "carelog-trust",
          "containerPath": "/run/carelog-trust",
          "readOnly": true
        }
      ],
      "environment": [
        {
          "name": "JAVA_TOOL_OPTIONS",
          "value": "-Djavax.net.ssl.trustStore=/run/carelog-trust/cacerts -Djavax.net.ssl.trustStorePassword=changeit"
        }
      ]
    }
  }
}
