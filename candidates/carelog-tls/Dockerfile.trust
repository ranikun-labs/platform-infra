# Carelog DEV trust-init image. CORE_IMAGE MUST be the Core image by digest (repo@sha256:...).
# Build: docker build -f Dockerfile.trust --build-arg CORE_IMAGE=<core>@sha256:<digest> --build-arg SOURCE_SHA=<sha> .
# hadolint global ignore=DL3002,DL3066
ARG CORE_IMAGE
FROM ${CORE_IMAGE}
ARG SOURCE_SHA=unknown
LABEL org.opencontainers.image.revision=$SOURCE_SHA \
      org.opencontainers.image.title="carelog-trust-init"
COPY trust-init.sh /usr/local/bin/trust-init
# Root is needed only to write the task volume (/run/carelog-trust). The Core base image already runs as root.
USER root
RUN chmod 755 /usr/local/bin/trust-init
ENTRYPOINT ["/usr/local/bin/trust-init"]
