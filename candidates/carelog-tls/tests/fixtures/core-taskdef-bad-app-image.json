{
  "family": "ranikun-platform-dev-core",
  "volumes": [
    { "name": "carelog-trust" }
  ],
  "containerDefinitions": [
    {
      "name": "ranikun-platform-dev-core",
      "image": "124495093425.dkr.ecr.ap-northeast-2.amazonaws.com/ranikun/platform/core@sha256:ad9f84289f980aa708ec15213050fb912168c6f76d3c61c93d67ecdc27780001",
      "essential": true,
      "portMappings": [ { "containerPort": 8081, "protocol": "tcp" } ],
      "environment": [
        { "name": "JAVA_TOOL_OPTIONS", "value": "-Djavax.net.ssl.trustStore=/run/carelog-trust/cacerts -Djavax.net.ssl.trustStorePassword=changeit" },
        { "name": "SPRING_PROFILES_ACTIVE", "value": "dev" }
      ],
      "mountPoints": [
        { "sourceVolume": "carelog-trust", "containerPath": "/run/carelog-trust", "readOnly": true }
      ],
      "dependsOn": [
        { "containerName": "carelog-trust-init", "condition": "SUCCESS" }
      ]
    },
    {
      "name": "carelog-trust-init",
      "image": "124495093425.dkr.ecr.ap-northeast-2.amazonaws.com/ranikun/platform/core-trust-init@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "essential": false,
      "mountPoints": [
        { "sourceVolume": "carelog-trust", "containerPath": "/run/carelog-trust", "readOnly": false }
      ]
    }
  ]
}
