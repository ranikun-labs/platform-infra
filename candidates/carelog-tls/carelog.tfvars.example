# REVIEW CANDIDATE ONLY. Replace all placeholders with reviewed ARNs and image digests.
# Carelog root: merge into a protected input file. The main container keeps localhost:8080.
enrollment_secret_arn = "REPLACE_WITH_ENROLLMENT_SECRET_ARN"
enrollment_core_security_group_id = "REPLACE_WITH_CORE_SECURITY_GROUP_ID"
enrollment_tls_candidate = {
  volume_names = ["carelog-tls"]
  app_port_mappings = []
  # SPRING_FLYWAY_ENABLED=false is required by dev-ecs-release.yml (lines 131-133); it is a plain env, never a secret.
  environment = {
    SERVER_ADDRESS = "127.0.0.1"
    CARELOG_IDENTITY_ENROLLMENT_ENABLED = "true"
    SPRING_FLYWAY_ENABLED = "false"
  }
  app_mount_points = []
  app_dependencies = []
  ecr_repository_arns = ["REPLACE_WITH_PROXY_ECR_REPOSITORY_ARN"]
  secret_arns = ["REPLACE_WITH_SERVER_BUNDLE_SECRET_ARN"]
  kms_key_arns = [] # Add only applicable customer-managed KMS key ARNs.
  containers = [{
    name = "carelog-tls-proxy"
    image = "REPLACE_WITH_PROXY_IMAGE_BY_SHA256"
    essential = true
    portMappings = [{ containerPort = 8080, protocol = "tcp" }, { containerPort = 8443, protocol = "tcp" }]
    mountPoints = [{ sourceVolume = "carelog-tls", containerPath = "/run/carelog-tls", readOnly = false }]
    secrets = [{ name = "TLS_BUNDLE_JSON", valueFrom = "REPLACE_WITH_SERVER_BUNDLE_SECRET_ARN" }]
    # The module passes containers through raw (modules/ecs-service additional_containers), so these must be explicit.
    # awslogs-group equals the module's aws_cloudwatch_log_group name "/ecs/<name>"; the execution role already allows PutLogEvents on it.
    logConfiguration = { logDriver = "awslogs", options = { awslogs-group = "/ecs/ranikun-carelog-dev-api", awslogs-region = "ap-northeast-2", awslogs-stream-prefix = "tls-proxy" } }
    # ECS ignores the Dockerfile HEALTHCHECK; this mirrors it (pid check on /run/nginx.pid).
    healthCheck = { command = ["CMD-SHELL", "kill -0 $(cat /run/nginx.pid) || exit 1"], interval = 30, timeout = 3, retries = 3, startPeriod = 10 }
  }]
}
