# Carelog DEV TLS front proxy. Rendered by proxy-entrypoint.sh: placeholders __TASK_IPV4__, __TLS_DIR__, __TLS_EXPECTED_DNS_SAN__.
#
# Topology (awsvpc task, one netns shared by proxy and carelog-be):
#   carelog-be app  -> 0.0.0.0:8080 (default bind). Gateway reaches it on TASK_IP:8080 directly. Internal endpoints
#                      accept loopback peers only (app-side check, carelog-be lane). This proxy never listens on 8080.
#   this proxy      -> __TASK_IPV4__:8443 TLS only, upstream 127.0.0.1:8080. The app therefore sees loopback for every
#                      Core request on 8443, which is what the app-side check needs. The proxy allowlist below decides
#                      which paths reach the app on 8443.
#
# Matching: regexes run on the decoded $uri. The request is forwarded raw (proxy_pass to an upstream group, no URI),
# so the app receives the exact request target. The path-only deny runs on the raw $request_uri before location
# matching, so an encoded spelling cannot reach the app as a different path. The query string is never inspected.

# Loopback-only health server for the container healthCheck. Not on the task IP.
server {
    listen 127.0.0.1:9180;
    server_tokens off;
    access_log off;

    location = /healthz {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:8081/actuator/health/liveness;
    }

    location / {
        return 404;
    }
}

upstream carelog_app {
    server 127.0.0.1:8080;
    keepalive 8;
    # Idle upstream connections close before Tomcat's own 60s keep-alive, so nginx never reuses a socket Tomcat has closed.
    keepalive_timeout 30s;
}

# No path and no query string in the log (both can carry identifiers). Status and timing only.
log_format carelog_tls '$time_local $remote_addr "$request_method" $status $request_time $upstream_status';

# TLS listener on the task IP. Core only: enrollment PUT and claims GET. Everything else is 403.
server {
    listen __TASK_IPV4__:8443 ssl;
    server_tokens off;
    merge_slashes off;
    ssl_certificate __TLS_DIR__/server.crt;
    ssl_certificate_key __TLS_DIR__/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4k;

    access_log /dev/stdout carelog_tls;
    default_type application/json;
    error_page 403 = @deny;
    error_page 413 = @toolarge;
    error_page 421 = @misdirected;

    # Timeouts are explicit. The app answers enrollment and claims well inside 60s; a stalled upstream is cut at 60s.
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    # Never retry on another attempt: enrollment is a PUT and must not be replayed silently.
    proxy_next_upstream off;

    location @deny {
        internal;
        return 403 '{"error":"forbidden"}';
    }

    location @toolarge {
        internal;
        return 413 '{"error":"payload_too_large"}';
    }

    location @misdirected {
        internal;
        return 421 '{"error":"misdirected"}';
    }

    # Path-only deny on the raw request target. "^[^?]*" limits every alternative to the path, so the query string
    # is never inspected. Alternatives:
    #   %      any percent-encoding in the path. Covers %2e %2f %3b %5c %00 %0a %0d %25. $uri is decoded before matching.
    #   ;      path parameters (Tomcat strips them, the proxy must not).
    #   #      fragment delimiter. Never valid in a request target, so it is refused rather than trimmed.
    #   \x5c   backslash.
    #   ..     dot segments anywhere.   /./  and a trailing /.  current-segment.
    #   //     empty segments (merge_slashes is off, so they are not collapsed).
    if ($request_uri ~ "^[^?]*(%|;|#|\x5c|\.\.|/\./|/\.(\?|\z)|//)") {
        return 403;
    }

    # Host must be the expected DNS name. $host is lower-case and has no port, so the JDK's "host:8443" matches.
    if ($host != "__TLS_EXPECTED_DNS_SAN__") {
        return 421;
    }

    # Core enrollment. accountId is a UUID (EnrollmentController: @PathVariable UUID). \z, not $: $ also matches
    # before a trailing newline, and a decoded %0a would otherwise pass. Authorization: app.
    location ~ "^/api/v1/internal/v1/identity/carelog/enrollments/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\z" {
        limit_except PUT { deny all; }
        proxy_pass http://carelog_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Core claims. accountId is a UUID (InternalIdentityClaimsController: @PathVariable UUID). Authorization: app.
    # The query string, if any, is passed through unchanged.
    location ~ "^/api/v1/internal/identity/claims/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\z" {
        limit_except GET { deny all; }
        proxy_pass http://carelog_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        return 403;
    }
}
